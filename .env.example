# Django
OPENFOTOS_ENVIRONMENT=local
DJANGO_SECRET_KEY=replace-me
SHARE_PIN_PEPPER=replace-me
PRIVACY_HASH_KEY=replace-me
CLOUDFLARE_ORIGIN_SECRET=replace-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,.localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost
# Deployed URLs must also include the encoded query option
# options=-csearch_path%3Dopenfotos%2Cextensions.
DATABASE_URL=postgresql://openfotos:openfotos@localhost:5432/openfotos
# Base64 of the Supabase CA certificate downloaded from Database Settings > SSL Configuration.
DATABASE_CA_CERT_BASE64=
OPENFOTOS_RUNTIME_DB_ROLE=openfotos_runtime
PUBLIC_BASE_DOMAIN=localhost
ADMIN_HOST=localhost
DJANGO_SECURE_HSTS_SECONDS=0
STUDIO_PRIVACY_EMAIL=balladsoflove@gmail.com
SOURCE_CODE_URL=https://github.com/openfotos/openfotos-platform

# Cloudflare R2
R2_ACCOUNT_ID=replace-me
R2_BUCKET_NAME=openfotos-development
R2_PARENT_ACCESS_KEY_ID=replace-me
R2_PARENT_SECRET_ACCESS_KEY=replace-me
# Override for MinIO, for example http://127.0.0.1:9000. R2 derives its endpoint from account ID.
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ADDRESSING_STYLE=path
READINESS_OBJECT_KEY=operations/readiness-sentinel.txt

# Limits
SIGNED_URL_TTL_SECONDS=300
PORTAL_SESSION_TTL_SECONDS=86400
FACE_DETECTOR_MODEL_PATH=/private/models/face_detection_yunet_2023mar.onnx
FACE_RECOGNIZER_MODEL_PATH=/private/models/face_recognition_sface_2021dec.onnx
AUTH_FAILURE_LIMIT=5
AUTH_FAILURE_WINDOW_SECONDS=900
PORTAL_PIN_FAILURE_LIMIT=10
DESKTOP_ACCESS_TTL_SECONDS=900
DESKTOP_REFRESH_TTL_SECONDS=1209600
DESKTOP_REFRESH_RETRY_GRACE_SECONDS=60
UPLOAD_LEASE_TTL_SECONDS=300
UPLOAD_LEASE_PAGE_SIZE=8
DESKTOP_API_MAX_BODY_BYTES=8388608
IDEMPOTENCY_TTL_SECONDS=2592000

# Optional services
SENTRY_DSN=
EMAIL_FROM_ADDRESS=
