# Django
DJANGO_SECRET_KEY=replace-in-secret-store
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,.localhost,127.0.0.1
DATABASE_URL=postgresql://openfotos:openfotos@localhost:5432/openfotos
PUBLIC_BASE_DOMAIN=localhost

# Cloudflare R2
R2_ACCOUNT_ID=replace-me
R2_BUCKET_NAME=openfotos-development
R2_PARENT_ACCESS_KEY_ID=replace-me
R2_PARENT_SECRET_ACCESS_KEY=replace-me
R2_LOCATION_HINT=apac
R2_TOKEN_VALUE=replace-me
# Override for MinIO, for example http://127.0.0.1:9000. R2 derives its endpoint from account ID.
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ADDRESSING_STYLE=path

# Face model
MODEL_ID=buffalo_m-pilot-v1
MODEL_DIRECTORY=./models

# Limits
SELFIE_MAX_BYTES=10485760
SIGNED_URL_TTL_SECONDS=600
EVENT_SESSION_TTL_SECONDS=86400
AUTH_FAILURE_LIMIT=5
AUTH_FAILURE_WINDOW_SECONDS=900
DESKTOP_ACCESS_TTL_SECONDS=900
DESKTOP_REFRESH_TTL_SECONDS=1209600
DESKTOP_REFRESH_RETRY_GRACE_SECONDS=60
UPLOADER_INVITATION_TTL_SECONDS=259200
UPLOAD_LEASE_TTL_SECONDS=300
UPLOAD_LEASE_PAGE_SIZE=8
DESKTOP_API_MAX_BODY_BYTES=8388608
IDEMPOTENCY_TTL_SECONDS=2592000

# Optional services
SENTRY_DSN=
EMAIL_FROM_ADDRESS=
