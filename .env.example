# Django
DJANGO_SECRET_KEY=replace-in-secret-store
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,.localhost,127.0.0.1
DATABASE_URL=postgresql://openfotos:openfotos@localhost:5432/openfotos
PUBLIC_BASE_DOMAIN=localhost

# Cloudflare R2
R2_ACCOUNT_ID=replace-me
R2_BUCKET_NAME=openfotos-development
R2_PARENT_ACCESS_KEY_ID=replace-me
R2_PARENT_SECRET_ACCESS_KEY=replace-me
R2_LOCATION_HINT=apac

# Face model
MODEL_ID=buffalo_m-pilot-v1
MODEL_DIRECTORY=./models

# Limits
SELFIE_MAX_BYTES=10485760
SIGNED_URL_TTL_SECONDS=600
EVENT_SESSION_TTL_SECONDS=86400
AUTH_FAILURE_LIMIT=5
AUTH_FAILURE_WINDOW_SECONDS=900

# Optional services
SENTRY_DSN=
EMAIL_FROM_ADDRESS=
